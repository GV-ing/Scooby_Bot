<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="M_PI" value="3.1415926535897931" />

  <!-- Generic RGBD camera model used by Scooby -->
  <xacro:macro name="scooby_camera_model" params="name parent *origin">
    <joint name="${name}_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="${name}_link"/>
    </joint>

    <link name="${name}_link">
      <inertial>
        <mass value="0.06" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.03 0.09 0.025" />
        </geometry>
        <material name="DarkGrey">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.03 0.09 0.025" />
        </geometry>
      </collision>
    </link>

    <joint name="${name}_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="${name}_link" />
      <child link="${name}_optical_frame"/>
    </joint>

    <link name="${name}_optical_frame"/>
  </xacro:macro>

  <xacro:macro name="scooby_rgbd_camera" params="name parent *origin">
    <xacro:scooby_camera_model name="${name}" parent="${parent}">
      <xacro:insert_block name="origin" />
    </xacro:scooby_camera_model>

    <gazebo reference="${name}_link">
      <sensor type="rgbd_camera" name="${name}_sensor">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <topic>/${name}</topic>
        <gz_frame_id>${name}_optical_frame</gz_frame_id>

        <camera>
          <horizontal_fov>${69.0 * M_PI/180.0}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>15.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
  