<?xml version="1.0"?>
<robot  xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find scooby_description)/urdf/utility_macro.xacro" />

  <xacro:macro name="scooby_base" >

  <!-- Odometry root frame -->
  <link name="base_footprint"/>

    <!-- Base properties (box: 0.13 x 0.09 x 0.11 m) -->
    <xacro:property name="base_length" value="0.13" /> <!-- X -->
    <xacro:property name="base_width" value="0.11" />  <!-- Y -->
    <xacro:property name="base_height" value="0.09" /> <!-- Z -->
    <xacro:property name="base_mass" value="5" />

    <!-- Wheel properties (cylinder: r=0.03, l=0.04) -->
    <xacro:property name="wheel_radius" value="0.03" />
    <xacro:property name="wheel_length" value="0.04" />
    <xacro:property name="wheel_mass" value="2.5" />

    <!-- Wheel separation (distanza tra i centri delle ruote su y) -->
    <xacro:property name="wheel_separation" value="0.14" />
    <!-- Wheel longitudinal offset (distanza tra asse centrale e ruote anteriori/posteriori su x) -->
    <xacro:property name="wheel_x_offset" value="0.075" />
   


    <xacro:property name="body_z_offset" value="${base_height/2.0 + caster_radius}" /> <!-- base completamente sopra la sfera -->
    <xacro:property name="caster_radius" value="0.018" /> <!-- raggio sfera caster -->
    <link name="base_link">

      <inertial>
        <origin xyz="0 0 0" />
        <mass value="${base_mass}" />
        <inertia 
          ixx="${(1/12.0)*base_mass*(base_width*base_width + base_height*base_height)}"
          ixy="0.0" ixz="0.0"
          iyy="${(1/12.0)*base_mass*(base_length*base_length + base_height*base_height)}"
          iyz="0.0"
          izz="${(1/12.0)*base_mass*(base_length*base_length + base_width*base_width)}" />
      </inertial>
      <visual>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}" />
        </geometry>
        <material name="Blue" />
        <origin xyz="0 0 0" rpy="0 0 0" />
      </visual>
      <collision>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

              <!-- Caster wheel (sfera) sotto la base -->
    <link name="caster_wheel_link1">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="Grey" />
        <origin xyz="0.02 0 -0.031" rpy="0 0 0" />
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <origin xyz="0.02 0 -0.031" rpy="0 0 0" />
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.01" />
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
      </inertial>
    </link>

    <!-- Joint fisso tra base e caster -->
    <joint name="caster_wheel_joint1" type="fixed">
      <parent link="base_link" />
      <child link="caster_wheel_link1" />
      <origin xyz="0.02 0 -0.031" rpy="0 0 0" />
    </joint>

                  <!-- Caster wheel (sfera) sotto la base -->
    <link name="caster_wheel_link2">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="Grey" />
        <origin xyz="-0.02 0 -0.031" rpy="0 0 0" />
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <origin xyz="-0.02 0 -0.031" rpy="0 0 0" />
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.01" />
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
      </inertial>
    </link>

    <!-- Joint fisso tra base e caster -->
    <joint name="caster_wheel_joint2" type="fixed">
      <parent link="base_link" />
      <child link="caster_wheel_link2" />
      <origin xyz="-0.02 0 -0.031" rpy="0 0 0" />
    </joint>
    <!-- Ruote: anteriore motrici, posteriore passive -->
    <link name="left_wheel_link">
      <visual>
        <geometry>
          <cylinder length="${wheel_length}" radius="${wheel_radius}" />
        </geometry>
        <material name="Black" />
        <origin xyz="0 0 0" rpy="0 1.5708 1.5708" />
      </visual>
      <collision>
        <geometry>
          <cylinder length="${wheel_length}" radius="${wheel_radius}" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 1.5708 1.5708" />
      </collision>
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="${wheel_mass}" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
      </inertial>
    </link>
    <link name="right_wheel_link">
      <visual>
        <geometry>
          <cylinder length="${wheel_length}" radius="${wheel_radius}" />
        </geometry>
        <material name="Black" />
        <origin xyz="0 0 0" rpy="0 1.5708 1.5708" />
      </visual>
      <collision>
        <geometry>
          <cylinder length="${wheel_length}" radius="${wheel_radius}" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 1.5708 1.5708" />
      </collision>
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="${wheel_mass}" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
      </inertial>
    </link>

    <!-- Additional Links -->
    <link name="d435_link">
    </link>
    <link name="lidar_link" />

    <!-- Joints -->
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint" />
      <child link="base_link" />
      <origin xyz="0.0 0.0 ${0.059 + body_z_offset}" rpy="0 0 ${-M_PI_2}" />
    </joint>
    <!-- Joint: sinistra (motrice) -->
    <joint name="left_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="left_wheel_link" />
      <origin xyz="0 ${wheel_separation/2.0} -0.05" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit effort="100" velocity="100" />
      <dynamics damping="0.5" friction="0.01" />
    </joint>
    <!-- Joint: destra (motrice) -->
    <joint name="right_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="right_wheel_link" />
      <origin xyz="0 -${wheel_separation/2.0} -0.05" rpy="0 0 ${-M_PI}" />
      <axis xyz="0 -1 0" />
      <limit effort="100" velocity="100" />
      <dynamics damping="0.5" friction="0.01" />
    </joint>
    <joint name="d435_joint" type="fixed">
      <parent link="base_link" />
      <child link="d435_link" />
      <origin xyz="0.07 0.0 0.0" rpy="0 0 0" />
    </joint>
    <joint name="lidar_joint" type="fixed">
      <parent link="base_link" />
      <child link="lidar_link" />
      <origin xyz="0.0 0.0 0.05" rpy="0 0 0" />
    </joint>

    <!-- Transmissions solo per le ruote motrici -->
    <transmission name="left_wheel_joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="left_wheel_joint" />
      <actuator name="left_wheel_joint_motor">
        <mechanicalReduction>1</mechanicalReduction>
        <hardwareInterface>EffortJointInterface</hardwareInterface>
      </actuator>
    </transmission>
    <transmission name="right_wheel_joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="right_wheel_joint" />
      <actuator name="right_wheel_joint_motor">
        <mechanicalReduction>1</mechanicalReduction>
        <hardwareInterface>EffortJointInterface</hardwareInterface>
      </actuator>
    </transmission>

    <!-- Plugin for differential drive control in Gazebo-->
    <gazebo>
      <!-- Plugin per 4 ruote: puoi sostituire con un plugin custom se necessario -->
      <plugin
        filename="libgz-sim-diff-drive-system.so"
        name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <!-- Limits for the differential drive -->
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <min_linear_acceleration>-1.0</min_linear_acceleration>
        <max_angular_acceleration>1.0</max_angular_acceleration>
        <min_angular_acceleration>-1.0</min_angular_acceleration>
        <max_linear_velocity>2.0</max_linear_velocity>
        <min_linear_velocity>-2.0</min_linear_velocity>
        <max_angular_velocity>2.0</max_angular_velocity>
        <min_angular_velocity>-2.0</min_angular_velocity>

        <odom_publish_frequency>50</odom_publish_frequency>
        <topic>/cmd_vel</topic>

        <!-- Odometry and TF topics -->
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>
      </plugin>

      <!-- Joint State Publisher plugin -->
      <plugin
        filename="libgz-sim-joint-state-publisher-system.so"
        name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>

